{
  "version": "1.7",
  "description": "人猫搭档 V1.7 最小入参 Schema。目标是先生成可检查、可返工的 story/frame/copy/prompt/qa 文本流水线，再进入真实图片生成。",
  "required": [
    "scene",
    "image_count",
    "continuous_story",
    "story_template"
  ],
  "defaults": {
    "ratio": "9:16",
    "platform": "抖音竖屏",
    "output_mode": "单张大图",
    "text_render_mode": "生成空白气泡 + 后期叠字图层",
    "in_image_storyboard": "关闭"
  },
  "fields": {
    "scene": {
      "type": "string",
      "example": "送外卖正面"
    },
    "angle": {
      "type": "string",
      "example": "第三人称正面中景"
    },
    "action": {
      "type": "string",
      "example": "接到第一单，准备出发"
    },
    "clothing": {
      "type": "string",
      "example": "外卖职业服"
    },
    "mood": {
      "type": "string",
      "example": "紧张但认真"
    },
    "extra": {
      "type": "string",
      "example": "每张图只推进一个明确动作，保持人猫和道具连续。"
    },
    "output_mode": {
      "type": "string",
      "enum": [
        "单张大图",
        "多镜头拼图"
      ],
      "default": "单张大图"
    },
    "ratio": {
      "type": "string",
      "enum": [
        "4:3",
        "9:16"
      ],
      "default": "9:16"
    },
    "platform": {
      "type": "string",
      "enum": [
        "通用",
        "抖音竖屏"
      ],
      "default": "抖音竖屏"
    },
    "image_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "required": true,
      "description": "本组故事需要生成的图片张数。V1.7 必填，用于保证 frame_plan/copy_plan/prompt_plan 数量一致。"
    },
    "continuous_story": {
      "type": "string",
      "enum": [
        "否",
        "是"
      ],
      "required": true,
      "description": "是：第 1 张生成锚点，第 2-N 张按顺序承接；否：同主题变体，不强制引用上一张成图。"
    },
    "story_template": {
      "type": "string",
      "enum": [
        "自动判断",
        "外卖跑单故事",
        "居家治愈故事"
      ],
      "required": true,
      "description": "V1.7 必填。用于生成 story_plan、mood_curve 和逐张剧情动作。"
    },
    "story_id": {
      "type": "string",
      "example": "delivery_first_day_001"
    },
    "story_title": {
      "type": "string",
      "example": "第一天送外卖"
    },
    "mood_curve": {
      "type": "array",
      "items": "string",
      "example": [
        "紧张",
        "小心",
        "专注",
        "进入状态",
        "有点慌",
        "放松"
      ]
    },
    "identity_lock": {
      "type": "string",
      "enum": [
        "强锁定",
        "普通锁定"
      ],
      "default": "强锁定"
    },
    "bubble_mode": {
      "type": "string",
      "enum": [
        "无",
        "人物气泡",
        "猫咪气泡",
        "双气泡",
        "旁白标题"
      ],
      "default": "双气泡"
    },
    "text_mode": {
      "type": "string",
      "enum": [
        "无文字",
        "直接生成文字",
        "空白气泡后期加字"
      ],
      "default": "空白气泡后期加字"
    },
    "text_render_mode": {
      "type": "string",
      "enum": [
        "仅生成文案清单",
        "生成空白气泡 + 文案清单",
        "生成空白气泡 + 后期叠字图层",
        "直接在图中生成文字"
      ],
      "default": "生成空白气泡 + 后期叠字图层",
      "description": "推荐空白气泡后期叠字，避免图片模型直接生成中文乱码。"
    },
    "text_position": {
      "type": "string",
      "enum": [
        "自动",
        "顶部标题区",
        "人物旁边",
        "猫咪旁边",
        "底部字幕区"
      ],
      "default": "自动"
    },
    "copywriting_mode": {
      "type": "string",
      "enum": [
        "手动填写",
        "自动根据情节生成"
      ],
      "default": "自动根据情节生成"
    },
    "interaction_mode": {
      "type": "string",
      "enum": [
        "不互动",
        "看向观众",
        "提问互动",
        "评论引导",
        "点赞关注",
        "选择投票"
      ],
      "default": "评论引导"
    },
    "title_text": {
      "type": "string",
      "maxLength": 16,
      "example": "第一单来了"
    },
    "narration_text": {
      "type": "string",
      "maxLength": 16,
      "example": "第一天跑单，先稳住"
    },
    "human_text": {
      "type": "string",
      "maxLength": 14,
      "example": "我先确认下"
    },
    "cat_text": {
      "type": "string",
      "maxLength": 14,
      "example": "要出发了吗"
    },
    "story_coherence": {
      "type": "string",
      "enum": [
        "普通",
        "强"
      ],
      "default": "强"
    },
    "outfit_style_lock": {
      "type": "string",
      "enum": [
        "不锁定",
        "弱锁定",
        "强锁定"
      ],
      "default": "强锁定"
    },
    "outfit_reference": {
      "type": "string",
      "enum": [
        "文字描述",
        "人物参考图",
        "第一张锚点图",
        "当前故事模板默认服装",
        "第一张锚点图 + 人物参考图"
      ],
      "default": "第一张锚点图 + 人物参考图"
    },
    "in_image_storyboard": {
      "type": "string",
      "enum": [
        "关闭",
        "开启"
      ],
      "default": "关闭",
      "description": "默认关闭。只有明确开启时，当前图才允许 2-3 个分镜。"
    },
    "storyboard_view": {
      "type": "string",
      "enum": [
        "第一人称",
        "第三人称",
        "第一人称 + 第三人称"
      ],
      "default": "第三人称"
    },
    "storyboard_layout": {
      "type": "string",
      "enum": [
        "上下分镜",
        "左右分镜",
        "主画面 + 小视角窗口"
      ],
      "default": "主画面 + 小视角窗口"
    },
    "qa_failures": {
      "type": "array",
      "description": "可选。用于手动标记已生成图片的失败项，脚本会写入 qa_result 并生成对应 retake_prompt。",
      "items": {
        "frame_index": "integer",
        "failed_items": "array<string>",
        "reason": "string"
      },
      "example": [
        {
          "frame_index": 2,
          "failed_items": [
            "服装道具连续性",
            "视觉证据不足"
          ],
          "reason": "猫背带贴片变化明显，检查装备动作不清楚"
        }
      ]
    }
  }
}
