{
  "version": "2.0",
  "description": "通用剧情连载系统最小入参 Schema。目标是先生成可检查、可返工的 story/frame/copy/prompt/qa 文本流水线，再进入真实图片生成。",
  "required": [
    "scene",
    "image_count",
    "continuous_story",
    "story_template"
  ],
  "defaults": {
    "ratio": "9:16",
    "platform": "抖音竖屏",
    "output_mode": "单张大图",
    "bubble_mode": "多角色气泡",
    "text_mode": "直接生成文字",
    "text_render_mode": "直接在图中生成文字",
    "title_render_mode": "不生成画面标题",
    "narration_mode": "底部旁白框",
    "emotion_acting_style": "克制现实",
    "expression_intensity": "轻微到中等",
    "body_language_mode": "手部/重心/距离表达",
    "detail_density": "丰富但不堆满",
    "conflict_intensity": "紧张增强",
    "action_momentum_mode": "明确动势",
    "shot_variation_mode": "远景建立 + 中景动作 + 特写反应",
    "panel_continuity_mode": "视线/手势/走位承接",
    "character_path_mode": "明确入口/站位/出口",
    "in_image_storyboard": "开启",
    "storyboard_view": "特写 + 中景 + 全景",
    "storyboard_layout": "主画面 + 特写小窗",
    "anchor_frame_index": 1
  },
  "fields": {
    "preset_name": {
      "type": "string",
      "description": "入口页常用配置模板名称。只用于记录本次使用的模板，不参与图片模型生成。"
    },
    "project_name": {
      "type": "string",
      "default": "通用剧情连载"
    },
    "story_id": {
      "type": "string"
    },
    "story_title": {
      "type": "string"
    },
    "story_template": {
      "type": "string",
      "required": true,
      "description": "用于选择剧情节奏模板。模板内容来自 config/story_templates.json，也可以在输入中传入 custom_frames 覆盖。"
    },
    "story_outline": {
      "type": "string",
      "description": "本次故事情节。用于描述故事从哪里开始、怎样推进、到哪里结束。"
    },
    "emotional_progression": {
      "type": "string",
      "description": "本组图的情绪推进逻辑。"
    },
    "scene": {
      "type": "string",
      "required": true
    },
    "angle": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "style_prompt": {
      "type": "string",
      "description": "本项目目标画风。"
    },
    "visual_gene_summary": {
      "type": "string",
      "description": "主角色、配角、关键身份特征和不可变化项。"
    },
    "worldview_summary": {
      "type": "string",
      "description": "世界观、场景系统、道具系统和风格边界。"
    },
    "key_props": {
      "type": "array",
      "items": "string",
      "description": "需要连续锁定的核心道具。"
    },
    "subject_state": {
      "type": "string",
      "description": "主体状态，可按项目填写角色、载具、道具、环境状态。"
    },
    "extra": {
      "type": "string",
      "description": "补充约束。用于填写额外要求、禁忌项和返工注意事项。"
    },
    "output_mode": {
      "type": "string",
      "enum": [
        "单张大图",
        "多镜头拼图"
      ],
      "default": "单张大图"
    },
    "ratio": {
      "type": "string",
      "enum": [
        "4:3",
        "9:16"
      ],
      "default": "9:16"
    },
    "platform": {
      "type": "string",
      "enum": [
        "通用",
        "抖音竖屏",
        "小红书图文"
      ],
      "default": "抖音竖屏"
    },
    "image_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "required": true
    },
    "continuous_story": {
      "type": "string",
      "enum": [
        "否",
        "是"
      ],
      "required": true
    },
    "mood_curve": {
      "type": "array",
      "items": "string"
    },
    "identity_lock": {
      "type": "string",
      "enum": [
        "强锁定",
        "普通锁定"
      ],
      "default": "强锁定"
    },
    "outfit_style_lock": {
      "type": "string",
      "enum": [
        "不锁定",
        "弱锁定",
        "强锁定"
      ],
      "default": "强锁定"
    },
    "outfit_reference": {
      "type": "string",
      "enum": [
        "文字描述",
        "身份参考图",
        "第一张锚点图",
        "当前故事模板默认造型",
        "第一张锚点图 + 身份参考图"
      ],
      "default": "第一张锚点图 + 身份参考图"
    },
    "bubble_mode": {
      "type": "string",
      "enum": [
        "无",
        "单角色气泡",
        "多角色气泡",
        "旁白标题"
      ],
      "default": "多角色气泡"
    },
    "text_mode": {
      "type": "string",
      "enum": [
        "无文字",
        "直接生成文字",
        "空白气泡后期加字"
      ],
      "default": "直接生成文字"
    },
    "text_render_mode": {
      "type": "string",
      "enum": [
        "仅生成文案清单",
        "生成空白气泡 + 文案清单",
        "生成空白气泡 + 后期叠字图层",
        "直接在图中生成文字"
      ],
      "default": "直接在图中生成文字"
    },
    "text_position": {
      "type": "string",
      "enum": [
        "自动",
        "顶部标题区",
        "主体旁边",
        "底部字幕区"
      ],
      "default": "自动"
    },
    "title_render_mode": {
      "type": "string",
      "enum": [
        "不生成画面标题",
        "封面图标题",
        "每帧标题"
      ],
      "default": "不生成画面标题",
      "description": "控制画面中是否出现顶部标题栏。默认不入图，避免生成第1幕、第2幕等分镜标签。"
    },
    "narration_mode": {
      "type": "string",
      "enum": [
        "底部旁白框",
        "旁白气泡",
        "画外文案清单",
        "不使用旁白"
      ],
      "default": "底部旁白框",
      "description": "旁白在漫画中的存放方式。画外文案清单表示只进任务文件，不进图片。"
    },
    "emotion_acting_style": {
      "type": "string",
      "enum": [
        "克制现实",
        "轻微外显",
        "沉默压抑",
        "紧绷防备",
        "保护性克制"
      ],
      "default": "克制现实",
      "description": "人物表演的整体情绪风格。默认避免夸张哭喊，用微表情和身体状态表达。"
    },
    "expression_intensity": {
      "type": "string",
      "enum": [
        "轻微",
        "轻微到中等",
        "中等",
        "强烈"
      ],
      "default": "轻微到中等",
      "description": "脸部表情强度。儿童和现实向漫画建议保持轻微到中等。"
    },
    "body_language_mode": {
      "type": "string",
      "enum": [
        "手部/重心/距离表达",
        "面部微表情优先",
        "保护性站位",
        "防备性蜷缩",
        "动作推进优先"
      ],
      "default": "手部/重心/距离表达",
      "description": "肢体语言表达方式，用于控制手、肩膀、站位、身体距离和重心。"
    },
    "detail_density": {
      "type": "string",
      "enum": [
        "丰富但不堆满",
        "标准",
        "极简"
      ],
      "default": "丰富但不堆满",
      "description": "控制场景、道具、前中后景细节密度。"
    },
    "conflict_intensity": {
      "type": "string",
      "enum": [
        "紧张增强",
        "克制紧张",
        "平静铺垫",
        "强冲突"
      ],
      "default": "紧张增强",
      "description": "控制画面冲突感和紧张感。"
    },
    "action_momentum_mode": {
      "type": "string",
      "enum": [
        "明确动势",
        "静态对话",
        "突然打断",
        "追逐/抢夺",
        "保护拦截"
      ],
      "default": "明确动势",
      "description": "控制动作是否有起点、方向、结果和速度感。"
    },
    "shot_variation_mode": {
      "type": "string",
      "enum": [
        "远景建立 + 中景动作 + 特写反应",
        "主画面 + 局部特写",
        "连续动作三格",
        "环境压迫 + 人物近景"
      ],
      "default": "远景建立 + 中景动作 + 特写反应",
      "description": "避免所有格子都是全景人物展示。"
    },
    "panel_continuity_mode": {
      "type": "string",
      "enum": [
        "视线/手势/走位承接",
        "前景道具承接",
        "上一格动作延续",
        "空间方位固定"
      ],
      "default": "视线/手势/走位承接",
      "description": "控制多格漫画之间的阅读连接感。"
    },
    "character_path_mode": {
      "type": "string",
      "enum": [
        "明确入口/站位/出口",
        "保护三角站位",
        "追逐推进",
        "靠近/退开"
      ],
      "default": "明确入口/站位/出口",
      "description": "控制人物动线和空间关系，让读者知道角色从哪里来、往哪里去。"
    },
    "in_image_storyboard": {
      "type": "string",
      "enum": [
        "关闭",
        "开启"
      ],
      "default": "开启",
      "description": "是否在单张图片内部生成2-3格漫画分镜。关闭时，每张输出图本身就是连续故事中的一格。"
    },
    "storyboard_view": {
      "type": "string",
      "enum": [
        "第一人称",
        "第三人称",
        "第一人称 + 第三人称",
        "特写 + 中景 + 全景"
      ],
      "default": "特写 + 中景 + 全景"
    },
    "storyboard_layout": {
      "type": "string",
      "enum": [
        "上下分镜",
        "左右分镜",
        "主画面 + 小视角窗口",
        "漫画三格竖排",
        "主画面 + 特写小窗"
      ],
      "default": "主画面 + 特写小窗"
    },
    "copywriting_mode": {
      "type": "string",
      "enum": [
        "手动填写",
        "自动根据情节生成"
      ],
      "default": "自动根据情节生成"
    },
    "interaction_mode": {
      "type": "string",
      "enum": [
        "不互动",
        "看向观众",
        "提问互动",
        "评论引导",
        "点赞关注",
        "选择投票"
      ],
      "default": "评论引导"
    },
    "character_lines": {
      "type": "array",
      "items": {
        "name": "string",
        "text": "string"
      }
    },
    "custom_frames": {
      "type": "array",
      "description": "可选。直接指定每张图的 scene/action/state/visual_evidence/camera。"
    },
    "project_negative_prompt": {
      "type": "string",
      "description": "项目专属负面词，会与通用负面词合并。"
    },
    "qa_failures": {
      "type": "array",
      "items": {
        "frame_index": "integer",
        "failed_items": "array<string>",
        "reason": "string"
      }
    }
  }
}
